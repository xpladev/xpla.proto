{
  "name": "@xpla/xpla.proto",
  "version": "1.14.0",
  "description": "JS and TS types relating to Protocol Buffers used by XPLA",
  "files": [
    "amino/",
    "cosmos/",
    "cosmos_proto/",
    "cosmwasm/",
    "ethermint/",
    "evmos/",
    "gogoproto/",
    "google/",
    "ibc/",
    "offchain/",
    "packetforward/",
    "ratelimit/",
    "tendermint/",
    "xpla/",
    "*.md"
  ],
  "scripts": {
    "generate": "./scripts/proto-gen.sh && npm run format",
    "format": "prettier --write --log-level warn \"./src/**/*.ts\"",
    "build": "npm run generate && rm -rf ./build && tsc && ./scripts/prepare.sh",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@improbable-eng/grpc-web": "0.15.0",
    "browser-headers": "0.4.1",
    "google-protobuf": "3.21.4"
  },
  "devDependencies": {
    "@types/google-protobuf": "3.15.12",
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "ts-proto": "2.15.0",
    "typescript": "7.0.2"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  }
}
